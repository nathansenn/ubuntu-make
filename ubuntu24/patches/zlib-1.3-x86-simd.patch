diff -Naur zlib-1.3.dfsg/configure zlib-1.3.dfsg/configure
--- zlib-1.3.dfsg/configure	2026-08-12 23:10:04.000000000 +0000
+++ zlib-1.3.dfsg/configure	2026-08-12 23:06:14.304750018 +0000
@@ -882,6 +882,58 @@
   echo "Checking for attribute(ifunc) support... No." | tee -a configure.log
 fi
 
+# Test to see if we can use x86_64 PCLMULQDQ CRC32 (Intel 2009 folding)
+echo >> configure.log
+cat > $test.c <<EOF
+#ifndef __x86_64__
+#error "Target is not x86_64"
+#endif
+#ifndef HAVE_IFUNC
+#error "Target doesn't support ifunc"
+#endif
+#include <wmmintrin.h>
+int main(void) {
+    __m128i a = _mm_setzero_si128();
+    a = _mm_clmulepi64_si128(a, a, 0);
+    return __builtin_cpu_supports("pclmul");
+}
+EOF
+if tryboth $CC -c $CFLAGS -mpclmul -msse4.1 $test.c; then
+  CFLAGS="$CFLAGS -DZ_X86_PCLMUL"
+  SFLAGS="$SFLAGS -DZ_X86_PCLMUL"
+  OBJC="$OBJC crc32_z_pclmul.o"
+  PIC_OBJC="$PIC_OBJC crc32_z_pclmul.lo"
+  echo "Checking for x86_64 PCLMUL CRC32... Yes." | tee -a configure.log
+else
+  echo "Checking for x86_64 PCLMUL CRC32... No." | tee -a configure.log
+fi
+
+# Test to see if we can use x86_64 SSSE3 Adler-32
+echo >> configure.log
+cat > $test.c <<EOF
+#ifndef __x86_64__
+#error "Target is not x86_64"
+#endif
+#ifndef HAVE_IFUNC
+#error "Target doesn't support ifunc"
+#endif
+#include <tmmintrin.h>
+int main(void) {
+    __m128i a = _mm_setzero_si128();
+    a = _mm_maddubs_epi16(a, a);
+    return __builtin_cpu_supports("ssse3");
+}
+EOF
+if tryboth $CC -c $CFLAGS -mssse3 $test.c; then
+  CFLAGS="$CFLAGS -DZ_X86_SSSE3"
+  SFLAGS="$SFLAGS -DZ_X86_SSSE3"
+  OBJC="$OBJC adler32_ssse3.o"
+  PIC_OBJC="$PIC_OBJC adler32_ssse3.lo"
+  echo "Checking for x86_64 SSSE3 Adler-32... Yes." | tee -a configure.log
+else
+  echo "Checking for x86_64 SSSE3 Adler-32... No." | tee -a configure.log
+fi
+
 # Test to see if we can use the optimizations for Power
 echo >> configure.log
 cat > $test.c <<EOF
