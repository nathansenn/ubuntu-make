diff -Naur zlib-1.3.dfsg/contrib/x86/x86.h zlib-1.3.dfsg/contrib/x86/x86.h
--- zlib-1.3.dfsg/contrib/x86/x86.h	1970-01-01 00:00:00.000000000 +0000
+++ zlib-1.3.dfsg/contrib/x86/x86.h	2026-08-12 23:07:59.972615191 +0000
@@ -0,0 +1,28 @@
+/* x86_64 PCLMUL CRC32 and SSSE3 Adler-32 for Ubuntu zlib 1.3
+ * For conditions of distribution and use, see copyright notice in zlib.h
+ */
+
+#ifndef ZLIB_CONTRIB_X86_H_
+#define ZLIB_CONTRIB_X86_H_
+
+#include "../../zconf.h"
+#include <cpuid.h>
+
+unsigned long _crc32_z_pclmul(unsigned long, const Bytef *, z_size_t);
+unsigned long _adler32_z_ssse3(unsigned long, const Bytef *, z_size_t);
+
+/* CPUID leaf 1 ECX bits. Safe in ifunc resolvers (no libgcc cpu-init). */
+#define Z_X86_ECX_PCLMUL (1u << 1)
+#define Z_X86_ECX_SSSE3  (1u << 9)
+#define Z_X86_ECX_SSE41  (1u << 19)
+
+static inline int
+z_x86_ecx_has(unsigned mask)
+{
+    unsigned eax, ebx, ecx, edx;
+    if (!__get_cpuid(1, &eax, &ebx, &ecx, &edx))
+        return 0;
+    return (ecx & mask) == mask;
+}
+
+#endif
