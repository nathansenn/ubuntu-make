-  get searchResults() {
-    return Main.overview._overview.controls._searchController._searchResults;
+  _tryAddProvider(provider) {
+    try {
+      const searchController = this.searchController;
+      if (!searchController)
+        return false;
+
+      searchController.addProvider(provider);
+      // Parental controls can refuse registration without throwing. The
+      // shell only attaches a display after a successful register; if we
