From: Ubuntu Desktop bug work
Date: Fri, 14 Aug 2026 00:00:00 +0000
Subject: snapd-prompting: tear down handler before D-Bus and null-check windows

disable() destroyed the D-Bus server before PromptsHandler, so lock-screen
disable raced against in-flight prompt-request. destroy() leaked window
groups and the bus name watch. _adjustPromptPosition crashed when every
snap window had already gone.

Forwarded: no
---
--- a/subprojects/snapd-prompting/snapd-prompting@canonical.com/extension.js
+++ b/subprojects/snapd-prompting/snapd-prompting@canonical.com/extension.js
@@ -38,9 +38,9 @@
     }
 
     disable() {
-        this._dbusServer?.destroy();
-        this._dbusServer = null;
         this._promptsHandler?.destroy();
         this._promptsHandler = null;
+        this._dbusServer?.destroy();
+        this._dbusServer = null;
     }
 }
--- a/subprojects/snapd-prompting/snapd-prompting@canonical.com/promptsHandler.js
+++ b/subprojects/snapd-prompting/snapd-prompting@canonical.com/promptsHandler.js
