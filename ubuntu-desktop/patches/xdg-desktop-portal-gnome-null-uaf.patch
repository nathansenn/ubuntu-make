+++ b/src/appchooserrow.c	2026-08-14 09:01:31.691790309 +0000
@@ -78,6 +78,14 @@
 
   g_set_object (&row->info, info);
 
+  if (info == NULL)
+    {
+      gtk_image_set_from_icon_name (GTK_IMAGE (row->icon), "application-x-executable");
+      gtk_image_set_pixel_size (GTK_IMAGE (row->icon), 32);
+      gtk_label_set_label (GTK_LABEL (row->name), "");
+      return row;
+    }
+
   icon = g_app_info_get_icon (info);
   if (!icon)
     icon = g_themed_icon_new ("application-x-executable");
--- a/src/accountdialog.c	2026-03-14 16:17:01.000000000 +0000
+++ b/src/accountdialog.c	2026-08-14 09:01:31.707790286 +0000
@@ -231,7 +231,7 @@
       id = g_strconcat (app_id, ".desktop", NULL);
       info = G_APP_INFO (g_desktop_app_info_new (id));
       heading = g_strdup_printf (_("Share your personal information with %1$s? %2$s"),
-                                 g_app_info_get_display_name (info),
